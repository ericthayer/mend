{
  "name": "mend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:quick": "PLAYWRIGHT_FAST=1 playwright test",
    "test:e2e:quick:hot": "PLAYWRIGHT_FAST=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test",
    "test:e2e:smoke": "PLAYWRIGHT_FAST=1 playwright test tests/e2e/primary-journey.spec.ts -g \"mobile happy path persists on reload and supports reset\"",
    "test:e2e:smoke:hot": "PLAYWRIGHT_FAST=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test tests/e2e/primary-journey.spec.ts -g \"mobile happy path persists on reload and supports reset\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.46.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
